{
    "$schema": "https://turborepo.com/schema.json",
    "tasks": {
        "dev": {
            "cache": false,
            "persistent": true,
            "passThroughEnv": [
                "LANGGRAPH_DEPLOYMENT_URL",
                "LANGSMITH_API_KEY"
            ]
        },
        "build": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                ".next/**",
                "!.next/cache/**",
                "dist/**"
            ]
        },
        "lint": {}
    }
}
