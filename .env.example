# Copy this file to .env and set your OpenAI API key. Everything else is optional:
# the commented-out lines show the defaults. Environment variables win over .env.
OPENAI_API_KEY=

# LLM of the orchestrator and both agents, as "provider:model" for LangChain.
# MODEL=openai:gpt-4o-mini

# Ports of the two A2A agents.
# DATABASE_AGENT_PORT=5001
# FILESYSTEM_AGENT_PORT=5002

# Where the orchestrator looks for agents, comma-separated. Defaults to the two agents above.
# AGENT_URLS=http://localhost:5001,http://localhost:5002
